# 本地配置模板：复制为 web/.env 后按需修改（.env 已 gitignore，不会提交）。
# 外部环境变量（如 shell 里 export 的）优先级高于本文件。

# 公网入口白名单（逗号分隔完整 origin，含端口）。后端默认只放行本机/内网
# 页面发起的浏览器请求（防公网恶意网页驱动访客浏览器调用本地 API）；
# 经公网 IP/域名映射访问前端时，页面 origin 是公网地址，须在此登记，
# 否则所有 /api 与 /v1 请求都会 403「不允许跨站调用本地 API」。
#PLAZA_ALLOWED_ORIGINS=http://203.0.113.10:14188

# 运行环境（test|prod），前后端共用：后端直接读，前端经 vite envPrefix 暴露。
# test  = 测试环境：「在线运行」工作台进入页面自动带入示例默认值，
#         并自动附带内置测试简历（一键运行测试）。
# prod  = 生产环境：表单干净，不预填任何演示默认值（缺省按 prod 处理）。
#PLAZA_ENV=test

# 运行记录页签是否展示（auto|true|false），前端读取：
# auto（缺省）= 跟随 PLAZA_ENV，仅测试环境展示；true/false = 强制开/关。
#PLAZA_SHOW_RUNS=auto

# pi CLI 路径（可选）。未设置时扫描 PATH 上的 pi。
#PI_CLI=/usr/local/bin/pi

# pi 以低权系统用户运行（手记 078；先跑 scripts/setup-pi-sandbox.sh 完成系统配置）。
# 设置后 pi 经 sudo -u 该用户运行，写权限被文件系统限制在 web/server/workspace 内，
# 仓库其余部分与家目录对它只读/不可达；此时 PI_CLI 必须是绝对路径，
# 通常指向配置脚本生成的包装脚本（pi-sandbox 内固定 PATH 后 exec pi）。
# 未设置（缺省）= 以当前用户直跑，开发机行为不变。
#PI_SANDBOX_USER=plaza-sandbox

# pi 运行模型，格式 provider/model，缺省 GPT-6 Astra。
# 模型需在本机 pi 中可用（pi --list-models astra）。
#PI_MODEL=openai-codex/gpt-6-astra

# 自部署 youcai（OpenAI Chat Completions 兼容，无需 API Key）。
# 选择后 PiRunner 自动加载仓库内 provider；不需要修改全局 ~/.pi 配置。
#PI_MODEL=youcai/youcai
# 地址须包含 /v1；缺省为已验证的优才服务，可在服务迁移后覆盖。
# sudo 低权沙箱部署时将覆盖值写在本文件复制出的 web/.env 中。
#YOUCAI_BASE_URL=https://u496025-7845e5610890.bjb2.seetacloud.com:8443/v1

# pi 思考档位（off/minimal/low/medium/high/xhigh/max），缺省 medium。
# 长推理是 token 消耗大头；可按需调低或调高。
#PI_THINKING=medium
# youcai 通过 Qwen chat_template_kwargs 控制思考开关：off 关闭，其余档位开启。
# 如需较快回复可用 PI_THINKING=off。

# pi 会话进程空闲回收阈值（毫秒），默认 30 分钟。
#PI_IDLE_MS=1800000

# 后端端口，默认 8767。改动后需同步修改 web/vite.config.ts 的 /api 代理目标。
#PORT=8767

# 单次运行超时（毫秒），默认：已安装真实技能 20 分钟，其余 10 分钟。
#RUN_TIMEOUT_MS=1200000

# 运行留痕目录，默认 web/server/traces/。
#TRACES_DIR=

# pi（DeepSeek）凭据：模型 key 走 pi 的读取顺序（环境变量如 DEEPSEEK_API_KEY）。
# 启动后端的 shell 里已 export 时无需配置；否则可在此写：
#DEEPSEEK_API_KEY=sk-...

# MySQL 只读查询工具（scripts/mysql-query.mjs）的连接配置。
# 配齐后沙箱 AGENTS.md 会向 Agent 声明该工具；缺省时不声明。
# 账号需仅 SELECT 权限（工具侧另有只读语句守卫，属防呆非安全边界）。
#MYSQL_HOST=192.168.x.x
#MYSQL_PORT=3306
#MYSQL_USER=readonly_user
#MYSQL_PASSWORD=...
#MYSQL_DATABASE=your_db
