[Unit]
Description=Skill Plaza foru2 frontend (Vite development server)

[Service]
Type=exec
WorkingDirectory=/home/wmq/skill-plaza-foru2/web
Environment=PATH=/opt/plaza-runtime/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/opt/plaza-runtime/bin/node node_modules/vite/bin/vite.js --host 0.0.0.0 --port 4189 --strictPort
Restart=on-failure
RestartSec=3s

[Install]
WantedBy=default.target
