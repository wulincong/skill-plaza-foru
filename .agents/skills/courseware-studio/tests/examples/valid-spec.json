      ],
      "safety": { "requiresConfirmation": true, "items": ["确认急停按钮位置与功能正常", "降速模式选择（T1）并确认速度 ≤250mm/s", "进入围栏前完成挂牌上锁（LOTO）", "四点示教顺序：姿态 1→2→3→4，逐点复核"] },
      "knowledgePoints": [ { "name": "安全操作规程", "standardId": "S2" } ],
      "sources": [ { "materialId": "M2", "pages": "任务三·安全须知", "note": "安全条目原文" } ]
